local function FetchStaff()
    local staff = {}
    local success, rRaw = pcall(function() return game:HttpGet("https://groups.roblox.com/v1/groups/"..GroupId.."/roles") end)
    if not success then return staff end
    local roles = HttpService:JSONDecode(rRaw).roles
    for _, role in ipairs(roles) do
        if StaffSettings.Roles[role.name] then
            local success2, uRaw = pcall(function() return game:HttpGet("https://groups.roblox.com/v1/groups/"..GroupId.."/roles/"..role.id.."/users?limit=100") end)
            if success2 then
                for _, user in ipairs(HttpService:JSONDecode(uRaw).data) do
                    table.insert(staff, {name = user.username, rank = role.name, userId = user.userId, online = Players:FindFirstChild(user.username) ~= nil})
                end
            end
        end
    end
    if StaffSettings.OnlyOnline then
        local filtered = {}
        for _, s in ipairs(staff) do if s.online then table.insert(filtered, s) end end
        staff = filtered
    end
    return staff
end

