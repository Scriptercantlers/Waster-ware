resume(create(function()
    RenderStepped:Connect(function(dt)
        local dtNum = typeof(dt) == "number" and dt or 0.016
        
        -- Always Morning
        if SilentAimSettings.MorningTime then
            game:GetService("Lighting").ClockTime = 8
        end

        -- Hitbox Expander
        if SilentAimSettings.HitboxExpander then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local parts = {}
                    if SilentAimSettings.HitboxType == "Head" then
                        local head = char:FindFirstChild("Head")
                        if head then table.insert(parts, head) end
                    else
                        for _, v in pairs(char:GetChildren()) do
                            if v:IsA("BasePart") and (v.Name:find("Torso") or v.Name:find("Arm") or v.Name:find("Leg")) then
                                table.insert(parts, v)
                            end
                        end
                    end
                    
                    for _, part in pairs(parts) do
                        part.Size = Vector3.new(SilentAimSettings.HitboxSize, SilentAimSettings.HitboxSize, SilentAimSettings.HitboxSize)
                        part.Transparency = 0.5
                        part.CanCollide = false
                    end
                end
            end
        else
            -- Check for players needing reset (simplified reset logic)
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local char = player.Character
                    local head = char:FindFirstChild("Head")
                    if head and head.Transparency == 0.5 then
                        head.Size = Vector3.new(2, 1, 1)
                        head.Transparency = 0
                        head.CanCollide = true
                    end
                    for _, v in pairs(char:GetChildren()) do
                        if v:IsA("BasePart") and v.Transparency == 0.5 and (v.Name:find("Torso") or v.Name:find("Arm") or v.Name:find("Leg")) then
                            if v.Name:find("Torso") then
                                v.Size = Vector3.new(2, 2, 1)
                            else
                                v.Size = Vector3.new(1, 2, 1)
                            end
                            v.Transparency = 0
                            v.CanCollide = true
                        end
                    end
                end
            end
        end

        -- 360 Check
        if SilentAimSettings.Check360Enabled then
            local count = 0
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                    -- Filter by team if requested
                    if SilentAimSettings.TeamCheck and player.Team == LocalPlayer.Team then continue end
                    
                    local hrp = player.Character.HumanoidRootPart
                    local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                    if dist <= 350 then -- Using 350 as distance as user mentioned 350 degrees (maybe they meant studs?)
                        count = count + 1
                    end
                end
            end
            check360_display.Visible = true
            check360_display.Text = "Players Around: " .. tostring(count)
            check360_display.Position = Vector2.new(Camera.ViewportSize.X / 2, 70)
        else
            check360_display.Visible = false
        end

        -- Third Person
        if SilentAimSettings.ThirdPersonEnabled then
            LocalPlayer.CameraMode = Enum.CameraMode.Classic
            LocalPlayer.CameraMaxZoomDistance = SilentAimSettings.ThirdPersonDistance
            LocalPlayer.CameraMinZoomDistance = SilentAimSettings.ThirdPersonDistance
        else
            LocalPlayer.CameraMinZoomDistance = 0.5
        end

        -- Anti Aim (Simple 180 Backwards - Upright Fix)
        if SilentAimSettings.AntiAimEnabled then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- Get camera look direction
                local look = Camera.CFrame.LookVector
                -- Zero out the Y axis to ensure the character stays strictly upright
                local horizontalLook = Vector3.new(look.X, 0, look.Z).Unit
                
                -- Target direction is exactly opposite (180 degrees)
                local targetLook = -horizontalLook
                
                -- Set CFrame at current position facing target direction (strictly horizontal)
                hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + targetLook)
            end
        end

        -- Vfly Logic
        if SilentAimSettings.VflyEnabled then
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart then
                local seat = hum.SeatPart
                local moveDir = Camera.CFrame.LookVector
                
                -- Basic fly: Move seat in camera direction
                seat.AssemblyLinearVelocity = moveDir * (SilentAimSettings.VflySpeed * 50)
                seat.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end

        -- Spider Logic
        if SilentAimSettings.SpiderEnabled then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local raycastParams = RaycastParams.new()
                raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                raycastParams.FilterDescendantsInstances = {char}
                
                -- Raycast in front of player
                local lookDir = hrp.CFrame.LookVector
                local result = workspace:Raycast(hrp.Position, lookDir * 1.5, raycastParams)
                
                if result then
                    -- If we hitting something, move up
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, SilentAimSettings.SpiderSpeed, hrp.AssemblyLinearVelocity.Z)
                end
            end
        end

        if SilentAimSettings.ShowSilentAimTarget and SilentAimSettings.Enabled then
            local HitPart = getClosestPlayer()
            if HitPart then 
                local RootToViewportPoint, IsOnScreen = WorldToViewportPoint(Camera, HitPart.Position);
                
                if IsOnScreen then
                    target_line.Visible = true
                    target_line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                    target_line.To = Vector2.new(RootToViewportPoint.X, RootToViewportPoint.Y)
                else
                    target_line.Visible = false
                end
            else 
                target_line.Visible = false 
            end
        else
            target_line.Visible = false 
        end
        
        getgenv().FOVSpeedBoost = getgenv().FOVSpeedBoost > 0.1 and getgenv().FOVSpeedBoost * 0.95 or 0
        fovRotation = (fovRotation + (10 + getgenv().FOVSpeedBoost) * dtNum) % 360
        
        if SilentAimSettings.FOVVisible then 
            fov_circle.Visible = true
            fov_circle.Position = getMousePosition()
            fov_circle.Radius = SilentAimSettings.FOVRadius
            fov_circle.Color = Color3.fromHSV((tick() * 0.1) % 1, 1, 1)
            fov_circle.Rotation = fovRotation
        else
            fov_circle.Visible = false
        end
        if fov_circle.Update then fov_circle:Update() end
        if target_line.Update then target_line:Update() end
        
        if zooming then
            Camera.FieldOfView = 7.5
        elseif SilentAimSettings.CustomCameraFOV then
            Camera.FieldOfView = SilentAimSettings.CameraFOVAmount
        end
        
        
        if SilentAimSettings.SimpleESPEnabled then
            for player, esp in pairs(SimpleESPObjects) do
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                
                local isAlive = humanoid and humanoid.Health > 0
                if character and humanoid and isAlive and player ~= LocalPlayer then
                    local onScreen, pos, size, dist = getSimpleESPBox(character, Camera)
                    
                    if onScreen and pos and size and dist then
                        esp:SetVisible(true)
                        
                        esp.Box.Position = pos
                        esp.Box.Size = size
                        esp.Box.Color = Color3.fromRGB(0, 255, 0)
                        
                        esp.Name.Text = tostring(player.Name) .. " [" .. tostring(math.floor(dist)) .. "]"
                        esp.Name.Color = Color3.fromRGB(255, 255, 255)
                        
                        esp.HealthText.Text = "HP: " .. tostring(math.floor(humanoid.Health))
                        local maxHp = humanoid.MaxHealth or 100
                        local hpPct = math.clamp(humanoid.Health / (maxHp > 0 and maxHp or 100), 0, 1)
                        local r = hpPct < 0.5 and 255 or math.floor(255 - (hpPct - 0.5) * 2 * 255)
                        local g = hpPct < 0.5 and math.floor(hpPct * 2 * 255) or 255
                        esp.HealthText.Color = Color3.fromRGB(r, g, 0)
                        
                        esp.Name.Position = Vector2.new(pos.X + size.X/2, pos.Y - 18)
                        esp.HealthText.Position = Vector2.new(pos.X + size.X/2, pos.Y + size.Y + 2)
                    else
                        esp:SetVisible(false)
                    end
                else
                    esp:SetVisible(false)
                end
            end
        else
            for _, esp in pairs(SimpleESPObjects) do
                esp:SetVisible(false)
            end
        end

        if SilentAimSettings.ESPEnabled then
            for player, esp in pairs(ESPObjects) do
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                
                local isAlive = humanoid and humanoid.Health > 0
                if character and humanoid and isAlive and player ~= LocalPlayer then
                    local onScreen, pos, size, dist = getESPBox(character, Camera)
                    
                    if onScreen then
                        esp:SetVisible(true)
                        
                        esp.Box.Color = Color3.fromRGB(220, 220, 220)
                        esp.Name.Color = Color3.fromRGB(220, 220, 220)
                        
                        local hpPct = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
                        esp.HealthBarFill.Size = Vector2.new(size.X * hpPct, 4)
                        local r = hpPct < 0.5 and 255 or math.floor(255 - (hpPct - 0.5) * 2 * 255)
                        local g = hpPct < 0.5 and math.floor(hpPct * 2 * 255) or 255
                        esp.HealthBarFill.Color = Color3.fromRGB(r, g, 0)
                        
                        esp.HealthText.Text = math.floor(humanoid.Health) .. " / " .. math.floor(humanoid.MaxHealth)
                        
                        local tool = character:FindFirstChildOfClass("Tool")
                        esp.EquippedText.Text = tool and tool.Name or "None"
                        
                        for _, part in pairs(character:GetDescendants()) do
                            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                                if part.Material ~= Enum.Material.Neon or part.Color ~= Color3.fromRGB(255, 255, 255) then
                                    part.Material = Enum.Material.Neon
                                    part.Color = Color3.fromRGB(255, 255, 255)
                                end
                                if part:IsA("MeshPart") and part.TextureID ~= "" then
                                    part.TextureID = ""
                                end
                            elseif part:IsA("SpecialMesh") then
                                if part.TextureId ~= "" then
                                    part.TextureId = ""
                                end
                            elseif part:IsA("Decal") or part:IsA("Texture") then
                                if part.Transparency ~= 1 then
                                    part.Transparency = 1
                                end
                            elseif part:IsA("Shirt") or part:IsA("Pants") or part:IsA("ShirtGraphic") or part:IsA("CharacterMesh") then
                                part:Destroy()
                            end
                        end
                        
                        if character:FindFirstChild("HumanoidRootPart") and not character.HumanoidRootPart:FindFirstChild("ESPLight") then
                            local light = Instance.new("PointLight")
                            light.Name = "ESPLight"
                            light.Color = Color3.fromRGB(255, 255, 255)
                            light.Brightness = 3
                            light.Range = 10
                            light.Parent = character.HumanoidRootPart
                        end
                        
                        esp.Box.Position = pos
                        esp.Box.Size = size
                        
                        esp.Name.Text = player.DisplayName .. " [" .. math.floor(dist) .. "m]"
                        esp.Name.Position = Vector2.new(pos.X + size.X/2, pos.Y - 18)
                        
                        esp.HealthBarBg.Position = Vector2.new(pos.X, pos.Y + size.Y + 2)
                        esp.HealthBarBg.Size = Vector2.new(size.X, 4)
                        esp.HealthBarFill.Position = esp.HealthBarBg.Position
                        
                        esp.HealthText.Position = Vector2.new(pos.X + size.X/2, pos.Y + size.Y + 6)
                        esp.EquippedText.Position = Vector2.new(pos.X + size.X/2, pos.Y + size.Y + 20)
                    else
                        esp:SetVisible(false)
                    end
                else
                    esp:SetVisible(false)
                end
            end
        else
            for _, esp in pairs(ESPObjects) do
                esp:SetVisible(false)
            end
        end

        -- Death Backpacks ESP (Independent of ESP type)
        if SilentAimSettings.DeathESPEnabled then
            local deathFolder = workspace:FindFirstChild("DeathBackpacks")
            if deathFolder then
                for _, obj in pairs(deathFolder:GetChildren()) do
                    if not DeathESPObjects[obj] then
                        DeathESPObjects[obj] = createDeathESP()
                    end
                    
                    local esp = DeathESPObjects[obj]
                    local primary = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("BasePart") and obj)
                    
                    if primary then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(primary.Position)
                        local dist = (Camera.CFrame.Position - primary.Position).Magnitude
                        
                        if onScreen and dist <= 100 then
                            local playerBoxHeight = (Camera:WorldToViewportPoint(primary.Position + Vector3.new(0, 3, 0)).Y - Camera:WorldToViewportPoint(primary.Position - Vector3.new(0, 3, 0)).Y)
                            local height = math.abs(playerBoxHeight) * 0.25 -- 1/4 size
                            local width = height * 1.2
                            
                            esp.Box.Visible = true
                            esp.Name.Visible = true
                            esp.DistText.Visible = true
                            
                            esp.Box.Position = Vector2.new(screenPos.X - width/2, screenPos.Y - height/2)
                            esp.Box.Size = Vector2.new(width, height)
                            
                            esp.Name.Position = Vector2.new(screenPos.X, screenPos.Y - height/2 - 14)
                            esp.DistText.Position = Vector2.new(screenPos.X, screenPos.Y + height/2 + 2)
                            esp.DistText.Text = "[" .. math.floor(dist) .. "m]"
                        else
                            esp:SetVisible(false)
                        end
                    else
                        esp:SetVisible(false)
                    end
                end
            end
            
            -- Cleanup removed backpacks
            for obj, esp in pairs(DeathESPObjects) do
                if not obj or not obj.Parent then
                    esp:SetVisible(false)
                    esp:Destroy()
                    DeathESPObjects[obj] = nil
                end
            end
        else
            for _, esp in pairs(DeathESPObjects) do
                esp:SetVisible(false)
            end
        end
        
        if SilentAimSettings.FlyJumpEnabled and flyActive then
            local character = LocalPlayer.Character
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local hrp = character and character:FindFirstChild("HumanoidRootPart")

            if humanoid and hrp and humanoid.Health > 0 then
                local elapsedTime = tick() - flyJumpStart
                local isHoldingJump = (tick() - lastJumpRequest) < 0.2
                
                if isHoldingJump and elapsedTime < 0.5 then
                    hrp.AssemblyLinearVelocity = Vector3.new(hrp.AssemblyLinearVelocity.X, 22, hrp.AssemblyLinearVelocity.Z)
                end
                
                if (isHoldingJump or elapsedTime < 0.1) and elapsedTime < 0.5 then
                    FlyJumpContainer.Visible = true
                    local progress = math.clamp(elapsedTime / 0.5, 0, 1)
                    FlyJumpBar.Size = UDim2.new(progress, 0, 1, 0)
                    
                    local r = progress < 0.5 and 255 or math.floor(255 - (progress - 0.5) * 2 * 255)
                    local g = progress < 0.5 and math.floor(progress * 2 * 255) or 255
                    FlyJumpBar.BackgroundColor3 = Color3.fromRGB(r, g, 0)
                    
                    FlyJumpText.Text = string.format("%.1fS", elapsedTime)
                elseif isHoldingJump and elapsedTime >= 0.5 then
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = {character}
                    
                    local result = workspace:Raycast(hrp.Position, Vector3.new(0, -9000, 0), params)
                    if result then
                        local hipHeight = humanoid.HipHeight > 0 and humanoid.HipHeight or 2
                        hrp.CFrame = CFrame.new(result.Position + Vector3.new(0, hipHeight + (hrp.Size.Y/2), 0))
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end
                    
                    flyActive = false
                    FlyJumpContainer.Visible = false
                else
                    if humanoid.FloorMaterial ~= Enum.Material.Air then
                        flyActive = false
                    end
                    FlyJumpContainer.Visible = false
                end
            else
                flyActive = false
                FlyJumpContainer.Visible = false
            end
        else
            FlyJumpContainer.Visible = false
        end
    end)
end))

local function isHempPrompt(prompt)
    local pName = string.lower(prompt.Name)
    local objText = string.lower(prompt.ObjectText or "")
    local actText = string.lower(prompt.ActionText or "")
    local parentName = prompt.Parent and string.lower(prompt.Parent.Name) or ""
    
    if string.find(pName, "hemp") or string.find(objText, "hemp") or string.find(actText, "hemp") or string.find(parentName, "hemp") then
        return true
    end
    return false
end

local promptsCache = {}

for _, obj in pairs(workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then
        table.insert(promptsCache, obj)
    end
end

workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        table.insert(promptsCache, obj)
    end
end)

workspace.DescendantRemoving:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        for i, p in ipairs(promptsCache) do
            if p == obj then
                table.remove(promptsCache, i)
                break
            end
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if SilentAimSettings.AutoHempEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local pivot = LocalPlayer.Character.HumanoidRootPart.Position
            
            for _, prompt in ipairs(promptsCache) do
                if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then
                    local dist = (pivot - prompt.Parent.Position).Magnitude
                    if dist <= (prompt.MaxActivationDistance + 2) then
                        if isHempPrompt(prompt) then
                            if fireproximityprompt then
                                fireproximityprompt(prompt)
                            else
                                prompt:InputHoldBegin()
                                task.wait(prompt.HoldDuration + 0.05)
                                prompt:InputHoldEnd()
                            end
                        end
                    end
                end
            end
        end
    end
end)

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(...)
    local Method = getnamecallmethod()
    local Arguments = {...}
    local self = Arguments[1]
    local chance = CalculateChance(SilentAimSettings.HitChance)
    if SilentAimSettings.Enabled and self == workspace and not checkcaller() and chance == true then
        
        local function isBulletRaycast(method, args)
            if method == "Raycast" then
                return args[3] and args[3].Magnitude > 15
            elseif method:lower():find("findpartonray") then
                local r = args[2]
                return r and r.Direction and r.Direction.Magnitude > 15
            end
            return false
        end

        -- Check if Method matches and it is a long enough raycast (to avoid hijacking short barrel bounds raycasts causing guns to break)
        if Method:lower() == SilentAimSettings.SilentAimMethod:lower() and isBulletRaycast(Method, Arguments) then
            local HitPart = getClosestPlayer()
            if HitPart then
                local origin
                
                if Method == "FindPartOnRayWithIgnoreList" then
                    if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithIgnoreList) then
                        origin = Arguments[2].Origin
                        Arguments[2] = Ray.new(origin, getDirection(origin, HitPart.Position))
                    end
                elseif Method == "FindPartOnRayWithWhitelist" then
                    if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRayWithWhitelist) then
                        origin = Arguments[2].Origin
                        Arguments[2] = Ray.new(origin, getDirection(origin, HitPart.Position))
                    end
                elseif (Method == "FindPartOnRay" or Method == "findPartOnRay") then
                    if ValidateArguments(Arguments, ExpectedArguments.FindPartOnRay) then
                        origin = Arguments[2].Origin
                        Arguments[2] = Ray.new(origin, getDirection(origin, HitPart.Position))
                    end
                elseif Method == "Raycast" then
                    if ValidateArguments(Arguments, ExpectedArguments.Raycast) then
                        origin = Arguments[2]
                        Arguments[3] = getDirection(origin, HitPart.Position)
                    end
                end

                if origin then
                    task.spawn(function()
                        if SilentAimSettings.ShowBulletTracers then CreateTracer(origin, HitPart.Position) end
                        getgenv().FOVSpeedBoost = 250 -- Tracer triggers speed boost!
                        if SilentAimSettings.ShowHitNotifications then NotifyHit(HitPart.Parent and HitPart.Parent.Name or "Unknown") end
                    end)
                    return oldNamecall(unpack(Arguments))
                end
            end
        end
    end
    return oldNamecall(...)
end))

local oldIndex = nil 
oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, Index)
    if self == Mouse and not checkcaller() and SilentAimSettings.Enabled and SilentAimSettings.SilentAimMethod == "Mouse.Hit/Target" and getClosestPlayer() then
        local HitPart = getClosestPlayer()
         
        if Index == "Target" or Index == "target" then 
            return HitPart
        elseif Index == "Hit" or Index == "hit" then 
            return ((SilentAimSettings.MouseHitPrediction and (HitPart.CFrame + (HitPart.Velocity * SilentAimSettings.MouseHitPredictionAmount))) or (not SilentAimSettings.MouseHitPrediction and HitPart.CFrame))
        elseif Index == "X" or Index == "x" then 
            return self.X 
        elseif Index == "Y" or Index == "y" then 
            return self.Y 
        elseif Index == "UnitRay" then 
            return Ray.new(self.Origin, (self.Hit - self.Origin).Unit)
        end
    end

    return oldIndex(self, Index)
end))


