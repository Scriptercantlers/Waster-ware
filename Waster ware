local function checkSound(v)
    if v:IsA("Sound") then
        if v.Name == "HitServer" then
            if SilentAimSettings.UwUHitSound then
                v.SoundId = "rbxassetid://139219844119994"
            end
            v:GetPropertyChangedSignal("SoundId"):Connect(function()
                if SilentAimSettings.UwUHitSound and v.SoundId ~= "rbxassetid://139219844119994" then
                    v.SoundId = "rbxassetid://139219844119994"
                end
            end)
        elseif v.Name == "PlayerOpenSound" then
            if SilentAimSettings.CuteOpenSound then
                v.SoundId = "rbxassetid://137965684634919"
            end
            v:GetPropertyChangedSignal("SoundId"):Connect(function()
                if SilentAimSettings.CuteOpenSound and v.SoundId ~= "rbxassetid://137965684634919" then
                    v.SoundId = "rbxassetid://137965684634919"
                end
            end)
        end
    end
end

pcall(function()
    for _, v in pairs(workspace:GetDescendants()) do checkSound(v) end
    for _, v in pairs(game:GetService("Players"):GetDescendants()) do checkSound(v) end
    for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do checkSound(v) end

    workspace.DescendantAdded:Connect(checkSound)
    game:GetService("Players").DescendantAdded:Connect(checkSound)
    game:GetService("ReplicatedStorage").DescendantAdded:Connect(checkSound)
end)

