local function RefreshStaffList(staff)
    for _, m in ipairs(MemberDrawings) do pcall(function() m.name:Remove() m.role:Remove() m.status:Remove() end) end
    MemberDrawings = {}
    local show = StaffSettings.Enabled and Expanded
    for _, s in ipairs(staff) do
        local n = Drawing.new("Text") n.Text = s.name; n.Size = 14; n.Color = StaffColors.Text; n.Visible = show
        local r = Drawing.new("Text") r.Text = s.rank; r.Size = 14; r.Color = StaffColors.Text; r.Visible = show
        local st = Drawing.new("Text") st.Text = s.online and "Online" or "Offline"; st.Size = 14; st.Color = s.online and StaffColors.Online or StaffColors.Offline; st.Visible = show
        table.insert(MemberDrawings, {name = n, role = r, status = st})
    end
    UpdateStaffPositions()
