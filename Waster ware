local SKIN_ID = "rbxassetid://109571469973979"
local appliedWeaponSkins = {}

local function applyWeaponSkin(part)
    if not part or not part:IsA("BasePart") then return end
    if part.Transparency >= 0.9 then return end

    local n = part.Name:lower()
    if n:find("arm") or n:find("hand") or n:find("leg") or n:find("torso") or n:find("head") then return end

    if appliedWeaponSkins[part] then return end
    appliedWeaponSkins[part] = true

    pcall(function()
        if part:IsA("MeshPart") then
            part.TextureID = SKIN_ID
        end
    end)

    for _, v in pairs(part:GetChildren()) do
        if v:IsA("Texture") or v:IsA("Decal") or v:IsA("SurfaceAppearance") then
            pcall(function()
                v:Destroy()
            end)
        end
    end

    for _, f in pairs(Enum.NormalId:GetEnumItems()) do
        local t = Instance.new("Texture")
        t.Name = "CustomSkin"
        t.Texture = SKIN_ID
        t.Face = f
        t.Parent = part
    end

    part.CastShadow = false
end

local function applyToolSkin(tool)
    if not SilentAimSettings.WeaponSkinEnabled then return end
    for _, d in pairs(tool:GetDescendants()) do
        applyWeaponSkin(d)
    end
end

_G.hookCharacter = function(char)
    appliedWeaponSkins = {}

    char.ChildAdded:Connect(function(obj)
        if obj:IsA("Tool") then
            task.wait(0.1)
            applyToolSkin(obj)
        end
    end)

    for _, obj in pairs(char:GetChildren()) do
        if obj:IsA("Tool") then
            applyToolSkin(obj)
        end
    end
end

