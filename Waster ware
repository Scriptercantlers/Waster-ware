local function getESPBox(character, camera)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    local rootPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
    if not onScreen then return false end
    
    local cf, size = character:GetBoundingBox()
    
    local topPos = camera:WorldToViewportPoint(cf.Position + Vector3.new(0, size.Y/2, 0))
    local bottomPos = camera:WorldToViewportPoint(cf.Position - Vector3.new(0, size.Y/2, 0))
    
    local height = math.abs(topPos.Y - bottomPos.Y)
    local width = height * 0.6
    
    local topY = math.min(topPos.Y, bottomPos.Y)
    
    return true, Vector2.new(rootPos.X - width/2, topY), Vector2.new(width, height), rootPos.Z
end


