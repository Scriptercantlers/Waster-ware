local function CreateTracer(Origin, EndPoint)
    if not Origin or not EndPoint then return end
    local Distance = (EndPoint - Origin).Magnitude
    if Distance < 0.1 then return end

    local Tracer = Instance.new("Part")
    Tracer.Name = "Tracer"
    Tracer.Anchored = true
    Tracer.CanCollide = false
    pcall(function() Tracer.CanQuery = false end)
    pcall(function() Tracer.CanTouch = false end)
    Tracer.Transparency = 0.3
    Tracer.Material = Enum.Material.Neon
    Tracer.Color = Color3.fromRGB(170, 0, 255)
    
    Tracer.Size = Vector3.new(0.1, 0.1, Distance)
    Tracer.CFrame = CFrame.lookAt(Origin, EndPoint) * CFrame.new(0, 0, -Distance / 2)
    
    pcall(function()
        Tracer.Parent = workspace.CurrentCamera or workspace.Terrain or workspace
    end)
    
    task.delay(5, function()
        pcall(function() Tracer:Destroy() end)
    end)
end

