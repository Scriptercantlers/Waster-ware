local target_line = (function()
    local LineGui = CreateOverlayGUI("TargetLineGui")

    local LineFrame = Instance.new("Frame")
    LineFrame.Parent = LineGui
    LineFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    LineFrame.BorderSizePixel = 0
    LineFrame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
    LineFrame.Active = false
    pcall(function() LineFrame.Interactable = false end)
    
    local line = {
        Visible = false,
        From = Vector2.new(0, 0),
        To = Vector2.new(0, 0),
        Color = Color3.fromRGB(255, 0, 0),
        Thickness = 2
    }
    
    function line:Update()
        LineFrame.Visible = self.Visible
        if self.Visible then
            local dist = (self.To - self.From).Magnitude
            LineFrame.Size = UDim2.new(0, dist, 0, self.Thickness)
            local center = (self.From + self.To) / 2
            LineFrame.Position = UDim2.new(0, center.X, 0, center.Y)
            LineFrame.Rotation = math.deg(math.atan2(self.To.Y - self.From.Y, self.To.X - self.From.X))
            LineFrame.BackgroundColor3 = self.Color
        end
    end
    
    return line
end)()

local fov_circle = (function()
    local FOVGui = CreateOverlayGUI("FOVCircleGui")

    local FOVContainer = Instance.new("Frame")
    FOVContainer.Parent = FOVGui
    FOVContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    FOVContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
    FOVContainer.BackgroundTransparency = 1
    FOVContainer.Size = UDim2.new(0, 0, 0, 0)
    FOVContainer.Active = false
    pcall(function() FOVContainer.Interactable = false end)
    
    local lines = {}
    for i = 1, 19 do
        local line = Instance.new("Frame")
        line.Parent = FOVContainer
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.BorderSizePixel = 0
        line.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
        
        local angle = math.rad((i - 1) * (360 / 19))
        table.insert(lines, {frame = line, angle = angle})
    end

    local circle = {
        Visible = false,
        Radius = 130,
        Position = Vector2.new(0, 0),
        Color = Color3.fromRGB(255, 255, 255),
        Transparency = 1,
        Rotation = 0,
        Lines = lines,
        Container = FOVContainer
    }
    
    function circle:Update()
        self.Container.Visible = self.Visible
        if self.Visible then
            self.Container.Position = UDim2.new(0, self.Position.X, 0, self.Position.Y)
            self.Container.Rotation = self.Rotation
            
            local d = self.Radius * math.cos(math.pi / 19)
            local s = 2 * self.Radius * math.sin(math.pi / 19)
            
            for i, lineData in ipairs(self.Lines) do
                local line = lineData.frame
                line.BackgroundColor3 = self.Color
                line.BackgroundTransparency = 1 - self.Transparency
                
                local angle = lineData.angle
                local x = math.cos(angle) * d
                local y = math.sin(angle) * d
                
                line.Position = UDim2.new(0, x, 0, y)
                line.Rotation = math.deg(angle) + 90
                line.Size = UDim2.new(0, s + 3, 0, 2)
            end
        end
    end
    
    return circle
end)()

